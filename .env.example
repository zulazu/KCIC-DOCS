# Copy to .env for local development. Never commit real credentials.
# Default setup: native PostgreSQL on 5432 + filesystem storage. No Docker required.

# --- Backend: database (native PostgreSQL 16+) ---
# Create once: CREATE ROLE kcic LOGIN PASSWORD '...'; CREATE DATABASE kcic_connect OWNER kcic;
KCIC_DB_URL=jdbc:postgresql://localhost:5432/kcic_connect
KCIC_DB_USERNAME=kcic
KCIC_DB_PASSWORD=change-me-local-only

# --- Backend: file storage ---
# filesystem = local dev (private directory, gitignored). minio = shared/production.
KCIC_STORAGE_PROVIDER=filesystem
# Use an absolute path; relative paths resolve against the backend module directory.
KCIC_STORAGE_LOCAL_ROOT=E:/KCIC/Qoder/kcic_connect/.local/storage-dev
KCIC_STORAGE_BUCKET=kcic-connect-documents
# MinIO settings — only used when KCIC_STORAGE_PROVIDER=minio:
# KCIC_STORAGE_ENDPOINT=http://localhost:9000
# KCIC_STORAGE_ACCESS_KEY=change-me
# KCIC_STORAGE_SECRET_KEY=change-me-local-only
# KCIC_STORAGE_REGION=us-east-1

# --- Backend: web/security ---
KCIC_COOKIE_SECURE=false
KCIC_APP_BASE_URL=http://localhost:5173

# --- Bootstrap administrator ---
# Only applied once, when the user table is empty.
# Password must be at least 12 characters. Rotate it after first login.
KCIC_BOOTSTRAP_ADMIN_USERNAME=admin
KCIC_BOOTSTRAP_ADMIN_PASSWORD=change-me-local-admin-password
KCIC_BOOTSTRAP_ADMIN_EMAIL=admin@kcic.example
# Optional: NIP of a verified ACTIVE Employee to link at creation. Required once V18
# (users.employee_id NOT NULL) is applied; the Employee must already exist.
KCIC_BOOTSTRAP_ADMIN_EMPLOYEE_NIP=

# --- Integration tests (optional) ---
# Dedicated test database, separate from the dev database. Create once:
#   CREATE DATABASE kcic_connect_test OWNER kcic;
# When unset, tests fall back to Testcontainers (requires Docker).
# KCIC_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/kcic_connect_test
# KCIC_TEST_DB_USERNAME=kcic
# KCIC_TEST_DB_PASSWORD=change-me-local-only

# --- Optional: docker compose infrastructure (not needed by default) ---
# POSTGRES_DB=kcic_connect
# POSTGRES_USER=kcic
# POSTGRES_PASSWORD=change-me-local-only
# POSTGRES_PORT=5433
# MINIO_ROOT_USER=kcic_minio_dev
# MINIO_ROOT_PASSWORD=change-me-local-only
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001